# CommerceAI Environment Variables
# Copy to .env and fill in real values. NEVER commit .env

# --- Node ---
NODE_ENV=development
PORT=3001

# --- Database (PostgreSQL) ---
POSTGRES_USER=commerceai
POSTGRES_PASSWORD=
POSTGRES_DB=commerceai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://commerceai:yourpassword@localhost:5432/commerceai

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# --- JWT ---
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# --- Google Gemini ---
GEMINI_API_KEY=

# --- Razorpay (Test Mode) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Frontend ---
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3001/api/v1
